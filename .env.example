# Copy this file to .env.local and fill in real values. .env.local is git-ignored — never commit
# real keys. Every var here must be prefixed VITE_ to be exposed to the client (Vite convention);
# only put values here that are safe to ship to the browser (the Supabase anon key is designed
# for this — it's constrained by Row Level Security policies, not a secret admin key).

# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
