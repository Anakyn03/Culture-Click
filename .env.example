[TEMPLATE]
# Copy this file to .env.local and fill in real values. .env.local is git-ignored — never commit
# real keys. Every var here must be prefixed VITE_ to be exposed to the client (Vite convention);
# only put values here that are safe to ship to the browser (the Supabase anon key is designed
# for this — it's constrained by Row Level Security policies, not a secret admin key).

# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Unsplash API (free tier: 50 requests/hour)
# Get your key at: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Google Maps Embed API (free tier: unlimited for non-commercial)
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable "Maps Embed API" in the Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
