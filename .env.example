[TEMPLATE]
# Copy this file to .env.local and fill in real values. .env.local is git-ignored — never
# commit real keys. Every var here must be prefixed VITE_ to be exposed to the client (Vite
# convention). Only put values here that are safe to ship to the browser: the Supabase anon
# key is designed for this, since it is constrained by Row Level Security rather than being
# a secret. Anything without the VITE_ prefix is read only by Node scripts, never bundled.

# ─── Client (safe to expose) ────────────────────────────────────────────────

# Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Maps Embed API (free tier: unlimited for non-commercial)
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable "Maps Embed API" in the Google Cloud Console
#
# IMPORTANT — application restrictions must allow your site. If the embedded map shows
# "This IP, site or mobile application is not authorized to use this API key", open
# Credentials → your key → Application restrictions → HTTP referrers and add:
#   http://localhost:5173/*        (local dev)
#   https://your-app.vercel.app/*  (production)
# (Or set restrictions to "None" while testing.) The app falls back to an
# "Open in Google Maps" link automatically when the embed is rejected.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Imagery needs no key: photos are loaded from Wikimedia Commons with sized URLs and a
# srcSet (see src/lib/photo.js), and credited on every hero image. Weather uses Open-Meteo,
# also with no key. Nothing to configure here.

# Sign-in setup (providers, redirect URLs, confirm-email) is a dashboard job — see
# GUIDE-SIGN-IN.md for the 10-minute walkthrough.

# ─── Server-side only (NEVER prefix with VITE_) ─────────────────────────────

# Used by `npm run seed` to load the atlas content into Supabase. Bypasses Row Level
# Security, so it must never reach the browser — do not add the VITE_ prefix, and do not
# commit it. Only needed when seeding or re-seeding; the app itself never uses it.
# Get it at: Supabase → Project Settings → API → service_role secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
